#!/usr/bin/env bash
#
# agent-account — keep several logged-in Claude Code, Codex and Cursor
# accounts and choose the one the NEXT session uses. A running session keeps
# its account.
#
# Each account other than "default" has its own home folder. For Claude Code
# and Codex it is the CLAUDE_CONFIG_DIR / CODEX_HOME of its sessions, and it
# links every entry of ~/.claude or ~/.codex (settings, skills, hooks,
# sessions...) except the login, so only the login differs. For Cursor it
# holds only an API key. The shim installed as "claude", "codex",
# "cursor-agent" and "agent" (agent-shim) reads the active account at every
# start. Each account can also have a label (shown to people) and a tag.

set -uo pipefail

self=$0
while [[ -L $self ]]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
# shellcheck source=lib/agent-account.sh
. "$(cd "$(dirname "$self")" && pwd -P)/lib/agent-account.sh"

usage() {
  cat <<'EOF'
Usage: agent-account <command>

  list [--json]                       the accounts of each provider; * = active
  use <provider> <id|label>           new sessions use that account
  add <provider> <id> [--label <text>] [--tag <text>]
                                      create the home of <id>; prints the login step
  set <provider> <id> [--label <text>] [--tag <text>]
                                      change the label or the tag ("" clears it)
  login <provider> <id>               log in to <id> (interactive)
  remove <provider> <id> [--yes]      delete the home of <id>
  env <provider> [<id>]               CLAUDE_CONFIG_DIR=... / CODEX_HOME=... /
                                      CURSOR_API_KEY_FILE=... for scripts
  usage cursor [--json] [--max-age <s>]
                                      the plan usage of each Cursor account
                                      (cached for --max-age seconds, default 300)

Providers: claude, codex, cursor. Account "default" is the normal home
(~/.claude, ~/.codex, Cursor's own login).
Ids: lowercase letters, digits, ".", "_" and "-", at most 32 characters.
Registry: $AGENT_ACCOUNTS_HOME (default ~/.local/share/agent-accounts).
EOF
}

die() {
  echo "agent-account: $*" >&2
  exit 1
}

need_provider() {
  aa_valid_provider "${1:-}" || die "unknown provider '${1:-}' (use claude, codex or cursor)"
}

# An account that exists: "default", or a valid id with a home folder.
account_exists() {
  [[ $2 == default ]] && return 0
  aa_valid_name "$2" && [[ -d $(aa_home "$1" "$2") ]]
}

need_account() {
  local provider=$1 name=${2:-}
  [[ -n $name ]] || die "missing account id"
  [[ $name == default ]] && return 0
  aa_valid_name "$name" || die "'$name' is not a valid account id"
  account_exists "$provider" "$name" ||
    die "no $provider account '$name' (create it with: agent-account add $provider $name)"
}

# accounts.json as an object; {} when it is missing or broken.
meta_json() {
  local file
  file=$(aa_meta_file "$1")
  if [[ -s $file ]] && jq -ce 'if type == "object" then . else error end' "$file" 2>/dev/null; then
    return 0
  fi
  echo '{}'
}

# An id, or a label that names exactly one existing account.
resolve_account() {
  local provider=$1 arg=${2:-} id ids=() count=0
  [[ -n $arg ]] || die "missing account id or label"
  if account_exists "$provider" "$arg"; then
    echo "$arg"
    return
  fi
  while IFS= read -r id; do
    account_exists "$provider" "$id" || continue
    ids+=("$id")
    count=$((count + 1))
  done < <(meta_json "$provider" | jq -r --arg l "$arg" 'to_entries[] | select(.value.label == $l) | .key')
  case $count in
    1) echo "${ids[0]}" ;;
    0) die "no $provider account with the id or label '$arg' (see: agent-account list)" ;;
    *) die "the label '$arg' names several $provider accounts (${ids[*]}); use the id" ;;
  esac
}

# default first, then the account folders by id.
account_names() {
  local dir entry name
  echo default
  dir="$(aa_root)/$1"
  [[ -d $dir ]] || return 0
  for entry in "$dir"/*; do
    [[ -d $entry ]] || continue
    name=${entry##*/}
    aa_valid_name "$name" && echo "$name"
  done
}

# One account as a JSON object. Never prints a token or a key: only the
# email, the account id and the plan leave jq.
account_json() {
  local provider=$1 name=$2 meta=${3:-} home file="" filter logged=null
  [[ -n $meta ]] || meta=$(meta_json "$provider")
  home=$(aa_home "$provider" "$name")
  local head='($meta[$name] // {}) as $m
    | {name: $name, id: $name, label: ($m.label // $name), tag: ($m.tag // null), home: $home}'
  case $provider in
    claude)
      file="$home/.claude.json"
      [[ $name == default ]] && file="$HOME/.claude.json"
      filter="$head"' + {
        email: (.oauthAccount.emailAddress // null),
        logged_in: (.oauthAccount != null),
        account_id: null}'
      ;;
    codex)
      file="$home/auth.json"
      filter='((.tokens.id_token // "") | split(".")) as $parts
        | (if ($parts | length) >= 2 then
             ($parts[1] | gsub("-"; "+") | gsub("_"; "/")
              | . + ("=" * ((4 - length % 4) % 4))
              | try (@base64d | fromjson) catch null)
           else null end) as $p
        | '"$head"' + {
           email: ($p.email // $p["https://api.openai.com/profile"].email // null),
           logged_in: (.tokens != null or .OPENAI_API_KEY != null),
           account_id: ($p["https://api.openai.com/auth"].chatgpt_account_id // null),
           plan: ($p["https://api.openai.com/auth"].chatgpt_plan_type // null)}'
      ;;
    cursor)
      # No network and no key read: the email is the label the user set, and
      # an account is logged in when its key file is not empty. The default
      # login lives in the Keychain, so it stays unknown (null).
      if [[ $name != default ]]; then
        if [[ -s $home/api-key ]]; then logged=true; else logged=false; fi
      fi
      filter="$head"' + {email: ($m.label // null), logged_in: $logged, account_id: null}'
      ;;
  esac
  # An empty or broken login file gives no object: fall back to the one below,
  # so the account still shows in the list.
  local out=""
  if [[ -n $file && -r $file ]]; then
    out=$(jq -c --arg name "$name" --arg home "$home" --argjson meta "$meta" --argjson logged "$logged" \
      "$filter" "$file" 2>/dev/null) || out=""
  fi
  if [[ -n $out ]]; then
    printf '%s\n' "$out"
    return 0
  fi
  echo '{}' | jq -c --arg name "$name" --arg home "$home" --argjson meta "$meta" \
    --argjson logged "$logged" "$filter"
}

provider_json() {
  local provider=$1 name meta
  meta=$(meta_json "$provider")
  for name in $(account_names "$provider"); do
    account_json "$provider" "$name" "$meta"
  done | jq -sc --arg active "$(aa_active "$provider")" '{active: $active, accounts: .}'
}

cmd_list() {
  local json
  json=$(jq -n --argjson claude "$(provider_json claude)" --argjson codex "$(provider_json codex)" \
    --argjson cursor "$(provider_json cursor)" \
    '{claude: $claude, codex: $codex, cursor: $cursor}') || die "could not read the accounts"
  if [[ ${1:-} == --json ]]; then
    echo "$json"
    return
  fi
  local provider mark label tag email state id
  for provider in $AA_PROVIDERS; do
    echo "$provider"
    while IFS=$'\t' read -r mark label tag email state id; do
      printf '  %s %-18s %-10s %-32s %-16s %s\n' "$mark" "$label" "$tag" "$email" "$state" "$id"
    done < <(jq -r --arg p "$provider" '.[$p] as $x | $x.accounts[]
      | [(if .id == $x.active then "*" else " " end), .label, (.tag // "-"),
         (if $p == "cursor" then "-" else (.email // "-") end),
         (if .logged_in == null then "login unknown"
          elif .logged_in then (if $p == "cursor" and .id != "default" then "key set" else "logged in" end)
          else (if $p == "cursor" then "no key" else "not logged in" end) end)
         + (if .plan then " " + .plan else "" end), "id: " + .id] | @tsv' <<<"$json")
    if ! jq -e --arg p "$provider" '.[$p] as $x | any($x.accounts[]; .id == $x.active)' \
      <<<"$json" >/dev/null; then
      echo "  ! the active account '$(aa_active "$provider")' has no home: new sessions fail"
    fi
  done
}

cmd_use() {
  local provider=${1:-} name dir tmp who
  need_provider "$provider"
  name=$(resolve_account "$provider" "${2:-}") || exit 1
  dir="$(aa_root)/$provider"
  mkdir -p "$dir" || die "cannot create $dir"
  tmp=$(mktemp "$dir/.active.XXXXXX") || die "cannot write in $dir"
  if ! { printf '%s\n' "$name" >"$tmp" && mv -f "$tmp" "$dir/active"; }; then
    rm -f "$tmp"
    die "cannot write $dir/active"
  fi
  who=$(account_json "$provider" "$name" |
    jq -r '.email // (if .logged_in == false then "not logged in" else .label end)')
  echo "$provider: new sessions use $name ($who); running sessions keep their account"
}

login_hint() {
  local provider=$1 name=$2 home=$3
  case $provider in
    claude)
      echo "Log in, in your own terminal:"
      echo "  agent-account login claude $name"
      echo "  (the same as: CLAUDE_CONFIG_DIR='$home' claude auth login)"
      ;;
    codex)
      echo "Log in, in your own terminal:"
      echo "  agent-account login codex $name"
      echo "  (the same as: CODEX_HOME='$home' codex login)"
      echo "  or copy an auth.json you already have: cp <auth.json> '$home/auth.json'"
      ;;
    cursor)
      echo "Save its API key (Cursor dashboard, API keys), in your own terminal:"
      echo "  agent-account login cursor $name"
      echo "  (the same as: ( umask 077; read -rs k; printf '%s\\n' \"\$k\" > '$home/api-key' ))"
      echo "  The key is read without echo; it never goes to the shell history or the screen."
      ;;
  esac
  echo "Then: agent-account use $provider $name"
}

# Split the arguments of add and set into positional ones and the options
# --label / --tag. A given option with an empty value clears it.
parse_meta_args() {
  POS=()
  LABEL_SET=0 LABEL=""
  TAG_SET=0 TAG=""
  while [[ $# -gt 0 ]]; do
    case $1 in
      --label)
        [[ $# -ge 2 ]] || die "--label needs a value"
        LABEL_SET=1 LABEL=$2
        shift
        ;;
      --label=*) LABEL_SET=1 LABEL=${1#--label=} ;;
      --tag)
        [[ $# -ge 2 ]] || die "--tag needs a value"
        TAG_SET=1 TAG=$2
        shift
        ;;
      --tag=*) TAG_SET=1 TAG=${1#--tag=} ;;
      -*) die "unknown option '$1'" ;;
      *) POS+=("$1") ;;
    esac
    shift
  done
}

apply_meta() {
  local provider=$1 name=$2
  if ((LABEL_SET)); then
    aa_meta_set "$provider" "$name" label "$LABEL" || die "cannot write $(aa_meta_file "$provider")"
  fi
  if ((TAG_SET)); then
    aa_meta_set "$provider" "$name" tag "$TAG" || die "cannot write $(aa_meta_file "$provider")"
  fi
  return 0
}

cmd_add() {
  local provider name home
  parse_meta_args "$@"
  provider=${POS[0]:-}
  name=${POS[1]:-}
  need_provider "$provider"
  [[ $name == default ]] && die "'default' is the normal home; it needs no add (to label it: agent-account set $provider default --label <text>)"
  aa_valid_name "$name" || die "'$name' is not a valid account id (a-z, 0-9, '.', '_', '-'; at most 32; not active or accounts.json)"
  home=$(aa_home "$provider" "$name")
  if [[ -d $home ]]; then
    echo "$provider account '$name' exists: $home (its own files are kept; links refreshed)"
  else
    (umask 077 && mkdir -p "$home") || die "cannot create $home"
    echo "$provider account '$name' created: $home"
  fi
  aa_refresh "$provider" "$home" || die "could not prepare $home (links or .claude.json)"
  apply_meta "$provider" "$name"
  login_hint "$provider" "$name" "$home"
}

cmd_set() {
  local provider name
  parse_meta_args "$@"
  provider=${POS[0]:-}
  name=${POS[1]:-}
  need_provider "$provider"
  need_account "$provider" "$name"
  ((LABEL_SET || TAG_SET)) || die "nothing to set (use --label and/or --tag)"
  apply_meta "$provider" "$name"
  account_json "$provider" "$name" | jq -r --arg p "$provider" \
    '"\($p) \(.id): label \(.label), tag \(.tag // "-")"'
}

# Read a Cursor API key from the terminal without echo and save it, mode 600.
save_cursor_key() {
  local home=$1 key="" tmp
  { printf 'API key for this Cursor account (not shown): ' >/dev/tty &&
    IFS= read -rs key </dev/tty && echo >/dev/tty; } 2>/dev/null ||
    die "no terminal to read the key; write $home/api-key yourself (mode 600)"
  [[ -n $key ]] || die "empty key: nothing saved"
  tmp=$(mktemp "$home/.api-key.XXXXXX") || die "cannot write in $home"
  chmod 600 "$tmp"
  if ! { printf '%s\n' "$key" >"$tmp" && mv -f "$tmp" "$home/api-key"; }; then
    rm -f "$tmp"
    die "cannot write $home/api-key"
  fi
  echo "Saved the key in $home/api-key."
}

cmd_login() {
  local provider=${1:-} name=${2:-} var home
  need_provider "$provider"
  need_account "$provider" "$name"
  shift 2
  var=$(aa_env_var "$provider")
  if [[ $name == default ]]; then
    unset "$var"
    export AGENT_ACCOUNT=""
  else
    home=$(aa_home "$provider" "$name")
    if [[ $provider == cursor ]]; then
      save_cursor_key "$home"
      return
    fi
    aa_refresh "$provider" "$home" || die "could not prepare $home (links or .claude.json)"
    export "$var=$home"
  fi
  case $provider in
    claude) exec claude auth login "$@" ;;
    codex) exec codex login "$@" ;;
    cursor) exec cursor-agent login "$@" ;;
  esac
}

# Claude Code on macOS keeps the login of a config dir in the Keychain item
# "Claude Code-credentials-<first 8 hex of sha256 of the dir path>".
keychain_item() {
  local hash
  if command -v shasum >/dev/null 2>&1; then
    hash=$(printf '%s' "$1" | shasum -a 256)
  else
    hash=$(printf '%s' "$1" | sha256sum)
  fi
  echo "Claude Code-credentials-${hash:0:8}"
}

cmd_remove() {
  local yes=0 args=() arg provider name home answer="" item
  for arg in "$@"; do
    case $arg in
      --yes | -y) yes=1 ;;
      *) args+=("$arg") ;;
    esac
  done
  provider=${args[0]:-}
  name=${args[1]:-}
  need_provider "$provider"
  [[ $name == default ]] && die "'default' is the normal home; it cannot be removed"
  need_account "$provider" "$name"
  [[ $(aa_active "$provider") == "$name" ]] &&
    die "'$name' is the active $provider account; first run: agent-account use $provider <other>"
  home=$(aa_home "$provider" "$name")
  if ((yes == 0)); then
    { printf 'Remove %s? Its login is lost. [y/N] ' "$home" >/dev/tty && read -r answer </dev/tty; } 2>/dev/null ||
      die "no terminal to confirm; add --yes"
    [[ $answer == [yY]* ]] || die "nothing removed"
  fi
  rm -rf -- "$home" || die "cannot remove $home"
  aa_meta_set "$provider" "$name" label "" && aa_meta_set "$provider" "$name" tag ""
  echo "Removed $home."
  if [[ $provider == claude && $(uname -s) == Darwin ]]; then
    item=$(keychain_item "$home")
    echo "Its login stays in the macOS Keychain as \"$item\". To delete it:"
    echo "  security delete-generic-password -s '$item'"
  fi
  if [[ $provider == cursor ]]; then
    echo "The API key file is deleted; the key itself stays valid until you revoke it in Cursor."
  fi
}

cmd_env() {
  local provider=${1:-} name=${2:-} var value=""
  need_provider "$provider"
  [[ -n $name ]] || name=$(aa_active "$provider")
  name=$(resolve_account "$provider" "$name") || exit 1
  var=$(aa_env_var "$provider")
  if [[ $name != default ]]; then
    value=$(aa_home "$provider" "$name")
  fi
  # The Cursor key is never printed: env gives the file that holds it.
  if [[ $provider == cursor ]]; then
    var=CURSOR_API_KEY_FILE
    [[ -n $value ]] && value=$value/api-key
  fi
  echo "$var=$value"
}

# --- usage cursor ---------------------------------------------------------------
#
# cursor-agent reads its usage from Cursor's dashboard API: Connect RPCs with a
# JSON body at api2.cursor.sh, with the login's access token as a bearer
# token. The default login keeps that token in the macOS Keychain (service
# cursor-access-token, account cursor-user) or, on Linux, in
# ${XDG_CONFIG_HOME:-~/.config}/cursor/auth.json. An API key is first
# exchanged for an access token, as cursor-agent does with CURSOR_API_KEY.
# Only read calls. A token or key never goes on a command line: curl reads it
# from its stdin as a config file.

cursor_api() { echo "${AGENT_ACCOUNT_CURSOR_API:-https://api2.cursor.sh}"; }

file_mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null; }

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# A secret goes into a quoted curl config line: no quote, backslash or space.
safe_secret() { [[ ${1:-} =~ ^[A-Za-z0-9._~+/=:-]+$ ]]; }

# POST a JSON body with a bearer secret. Prints the body, then the HTTP code
# on the last line.
cursor_post() { # secret path body
  printf 'header = "Authorization: Bearer %s"\n' "$1" |
    curl -sS -m "${AGENT_ACCOUNT_CURSOR_TIMEOUT:-15}" -K - -X POST \
      -H 'Content-Type: application/json' -H 'Connect-Protocol-Version: 1' \
      --data "$3" -w '\n%{http_code}' "$(cursor_api)$2" 2>/dev/null
}

# The exp claim of a JWT, 0 when it has none. The token goes to jq on a pipe.
jwt_exp() {
  printf '%s' "$1" | jq -Rr 'split(".") | .[1] // ""
    | gsub("-"; "+") | gsub("_"; "/") | . + ("=" * ((4 - length % 4) % 4))
    | (try (@base64d | fromjson | .exp // 0) catch 0) | numbers // 0' 2>/dev/null || echo 0
}

# The login of the default Cursor account: "token <t>", "key <k>" or nothing.
cursor_default_login() {
  local token="" key="" file
  if [[ $(uname -s) == Darwin ]]; then
    token=$(security find-generic-password -s cursor-access-token -a cursor-user -w 2>/dev/null) || token=""
    [[ -n $token ]] ||
      key=$(security find-generic-password -s cursor-api-key -a cursor-user -w 2>/dev/null) || key=""
  else
    file=${XDG_CONFIG_HOME:-$HOME/.config}/cursor/auth.json
    if [[ -r $file ]]; then
      token=$(jq -r '.accessToken // empty | strings' "$file" 2>/dev/null) || token=""
      key=$(jq -r '.apiKey // empty | strings' "$file" 2>/dev/null) || key=""
    fi
  fi
  if [[ -n $token ]]; then
    echo "token $token"
  elif [[ -n $key ]]; then
    echo "key $key"
  fi
}

usage_error() { # id updated-at message
  jq -nc --arg id "$1" --arg now "$2" --arg e "$3" '{provider: "cursor", id: $id,
    plan: null, used_percent: null, spent_usd: null, limit_usd: null, resets_at: null,
    window_minutes: null, updated_at: $now, error: $e}'
}

# One Cursor account as a usage object. Every failure is an object with
# error set, never an exit.
cursor_usage_fetch() { # id
  local id=$1 now login="" kind secret token="" out code body usage plan="{}" exp
  now=$(now_iso)
  fail() { usage_error "$id" "$now" "$1"; }
  command -v curl >/dev/null 2>&1 || { fail "curl not found"; return; }
  if [[ $id == default ]]; then
    login=$(cursor_default_login)
    [[ -n $login ]] || { fail "no Cursor login found (run: cursor-agent login)"; return; }
  else
    local keyfile
    keyfile="$(aa_home cursor "$id")/api-key"
    [[ -r $keyfile ]] && IFS= read -r secret <"$keyfile"
    [[ -n ${secret:-} ]] || { fail "no API key (run: agent-account login cursor $id)"; return; }
    login="key $secret"
  fi
  kind=${login%% *}
  secret=${login#* }
  safe_secret "$secret" || { fail "the stored $kind has an unexpected format"; return; }
  if [[ $kind == key ]]; then
    out=$(cursor_post "$secret" /auth/exchange_user_api_key '{}') || { fail "network error"; return; }
    code=${out##*$'\n'}
    [[ $code == 200 ]] || { fail "the API key was refused (HTTP $code)"; return; }
    token=$(printf '%s' "${out%$'\n'*}" | jq -r '.accessToken // empty | strings' 2>/dev/null)
    [[ -n $token ]] || { fail "unknown answer to the API key exchange"; return; }
    safe_secret "$token" || { fail "the access token has an unexpected format"; return; }
  else
    token=$secret
  fi
  exp=$(jwt_exp "$token")
  if [[ $exp =~ ^[0-9]+$ ]] && ((exp > 0 && exp < $(date +%s))); then
    fail "the login expired (start cursor-agent once to refresh it)"
    return
  fi
  out=$(cursor_post "$token" /aiserver.v1.DashboardService/GetCurrentPeriodUsage '{}') ||
    { fail "network error"; return; }
  code=${out##*$'\n'}
  [[ $code == 200 ]] || { fail "usage request failed (HTTP $code)"; return; }
  usage=${out%$'\n'*}
  out=$(cursor_post "$token" /aiserver.v1.DashboardService/GetPlanInfo '{}') && {
    code=${out##*$'\n'}
    [[ $code == 200 ]] && plan=${out%$'\n'*}
  }
  jq -nc --arg id "$id" --arg now "$now" --argjson u "$usage" --argjson p "$plan" '
    def num: if type == "number" then . elif type == "string" then (tonumber? // null) else null end;
    if ($u | type) != "object" or (($u.planUsage == null) and ($u.billingCycleEnd == null)) then
      error("unknown")
    else . end
    | ($u.billingCycleStart | num) as $s | ($u.billingCycleEnd | num) as $e
    | ($u.planUsage // {}) as $pu
    | (($pu.limit | num) // 0) as $lim | ($pu.totalSpend | num) as $sp
    | {provider: "cursor", id: $id,
       plan: (($p.planInfo.planName // null) | if . == "" then null else . end),
       used_percent: (($pu.totalPercentUsed | num)
         // (if $lim > 0 then (($sp // 0) / $lim * 100) else null end)),
       spent_usd: (if $sp != null then $sp / 100 elif $lim > 0 then 0 else null end),
       limit_usd: (if $lim > 0 then $lim / 100 else null end),
       resets_at: (if $e then ($e / 1000 | floor | todate) else null end),
       window_minutes: (if $s and $e and $e > $s then (($e - $s) / 60000 + 0.5 | floor) else null end),
       updated_at: $now, error: null}' 2>/dev/null || fail "unknown answer from the usage API"
}

usage_cache_file() { # id
  echo "${XDG_CACHE_HOME:-$HOME/.cache}/agent-usage/cursor/$1.json"
}

# A reading younger than max-age comes from the cache; else it is fetched and
# cached (an error too, so a broken account is not asked again every second).
cursor_usage_one() { # id max-age
  local id=$1 max=$2 file dir mtime out tmp
  file=$(usage_cache_file "$id")
  if [[ -r $file ]] && ((max > 0)); then
    mtime=$(file_mtime "$file")
    if [[ $mtime =~ ^[0-9]+$ ]] && (($(date +%s) - mtime < max)) &&
      out=$(jq -ce 'select(type == "object" and .provider == "cursor")' "$file" 2>/dev/null); then
      printf '%s\n' "$out"
      return
    fi
  fi
  out=$(cursor_usage_fetch "$id")
  printf '%s\n' "$out"
  dir=${file%/*}
  mkdir -p "$dir" 2>/dev/null || return 0
  tmp=$(mktemp "$dir/.$id.XXXXXX" 2>/dev/null) || return 0
  if printf '%s\n' "$out" >"$tmp"; then mv -f "$tmp" "$file"; else rm -f "$tmp"; fi
}

cmd_usage() {
  local provider="" json=0 max=300 id all
  while [[ $# -gt 0 ]]; do
    case $1 in
      --json) json=1 ;;
      --max-age)
        [[ $# -ge 2 ]] || die "--max-age needs a value"
        max=$2
        shift
        ;;
      --max-age=*) max=${1#--max-age=} ;;
      -*) die "unknown option '$1'" ;;
      *) [[ -z $provider ]] || die "too many arguments"; provider=$1 ;;
    esac
    shift
  done
  [[ $provider == cursor ]] || die "usage reads only cursor accounts (agent-account usage cursor --json)"
  [[ $max =~ ^[0-9]+$ ]] || die "--max-age takes a number of seconds"
  all=$(for id in $(account_names cursor); do cursor_usage_one "$id" "$max"; done | jq -sc .) ||
    die "could not read the cursor usage"
  if ((json)); then
    echo "$all"
    return
  fi
  jq -r '.[] | "  \(.id)  " + (if .error then "! \(.error)" else
      "\(.plan // "-")  " + (if .used_percent then "\(.used_percent * 10 | floor / 10)%" else "-" end)
      + (if .spent_usd then "  $\(.spent_usd)" + (if .limit_usd then " of $\(.limit_usd)" else "" end) else "" end)
      + (if .resets_at then "  resets \(.resets_at)" else "" end) end)' <<<"$all"
}

cmd=${1:-}
[[ $# -gt 0 ]] && shift
case $cmd in
  -h | --help | help) usage; exit 0 ;;
  "") usage; exit 1 ;;
esac

command -v jq >/dev/null 2>&1 || die "jq is required (brew install jq / apt install jq)"

case $cmd in
  list | ls) cmd_list "$@" ;;
  use) cmd_use "$@" ;;
  add) cmd_add "$@" ;;
  set) cmd_set "$@" ;;
  login) cmd_login "$@" ;;
  remove | rm) cmd_remove "$@" ;;
  env) cmd_env "$@" ;;
  usage) cmd_usage "$@" ;;
  *) usage >&2; die "unknown command '$cmd'" ;;
esac
