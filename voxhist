#!/usr/bin/env zsh
#
# voxhist — keep the last Voxtype transcriptions so a lost one can be copied
# again. Voxtype itself keeps no history: its log restarts with the daemon.
#
# `voxhist record` is the Voxtype post-process hook: it gets each transcription
# on stdin, prints it back unchanged (Voxtype types what the hook prints) and
# saves it. `voxhist app` builds VoxHistBar, a menu bar list that copies an
# entry on click (macOS). The history file is shared by both.
#
emulate -L zsh
zmodload zsh/datetime

HIST=${VOXHIST_FILE:-${XDG_DATA_HOME:-$HOME/.local/share}/terminal-tools/voxhist}
MAX=${VOXHIST_MAX:-15}
RS=$'\036'   # record separator: a dictation can hold newlines and tabs, never this

usage() {
  cat <<'EOF'
voxhist — the last Voxtype transcriptions, to copy one again

  voxhist             list them, newest first (default)
  voxhist copy [n]    copy entry n to the clipboard (1 = newest, the default)
  voxhist clear       delete the history
  voxhist hook        print the Voxtype config that saves each transcription
  voxhist app         build and open VoxHistBar, the menu bar list (macOS)
  voxhist record      the hook itself: stdin -> stdout unchanged, then saved

Keeps the last 15 (VOXHIST_MAX) in ~/.local/share/terminal-tools/voxhist,
readable only by you. Everything you dictate lands there in plain text.
EOF
}

# The file is records "<epoch>\t<text>" joined by RS, oldest first.
typeset -ga ENTRIES
load() {
  ENTRIES=()
  [[ -r $HIST ]] && ENTRIES=( "${(@ps:$RS:)$(<$HIST)}" )
  ENTRIES=( "${(@)ENTRIES:#}" )
}

record() {
  local text
  text=$(cat; print -n x); text=${text%x}   # $(...) would drop trailing newlines
  print -rn -- "$text"
  [[ -n ${text//[[:space:]]/} ]] || return 0
  umask 077
  mkdir -p ${HIST:h}
  load
  ENTRIES+=( "$EPOCHSECONDS"$'\t'"$text" )
  (( ${#ENTRIES} > MAX )) && ENTRIES=( "${(@)ENTRIES[-MAX,-1]}" )
  # Write then rename, so the menu bar app never reads half a file.
  print -rn -- "${(pj:$RS:)ENTRIES}" > $HIST.tmp && mv -f $HIST.tmp $HIST
}

case ${1:-list} in
  -h|--help) usage ;;

  record) record ;;

  list)
    load
    if (( ! ${#ENTRIES} )); then
      print -u2 "voxhist: no transcriptions yet — see 'voxhist hook'"
      exit 0
    fi
    local i entry
    for (( i = ${#ENTRIES}; i >= 1; i-- )); do
      entry=${ENTRIES[i]}
      printf '\033[36m%2d\033[0m \033[38;5;243m%s\033[0m  %s\n' $(( ${#ENTRIES} - i + 1 )) \
        "$(strftime '%d/%m %H:%M' ${entry%%$'\t'*})" "${${entry#*$'\t'}//$'\n'/ ⏎ }"
    done
    ;;

  copy)
    load
    local n=${2:-1}
    if [[ $n != <1-> ]] || (( n > ${#ENTRIES} )); then
      print -u2 "voxhist: no entry $n (${#ENTRIES} saved)"
      exit 1
    fi
    source ${0:A:h}/lib/kubetui.zsh   # clip: the one cross-platform clipboard helper
    local entry=${ENTRIES[$(( ${#ENTRIES} - n + 1 ))]}
    clip "${entry#*$'\t'}"
    ;;

  clear)
    rm -f $HIST && print "voxhist: history cleared"
    ;;

  hook)
    cat <<EOF
Add this to ~/Library/Application Support/voxtype/config.toml (macOS) or
~/.config/voxtype/config.toml (Linux), then restart the daemon:

[output.post_process]
command = "${0:A} record"
timeout_ms = 2000

macOS restart: launchctl kickstart -k gui/\$(id -u)/io.voxtype.daemon
The path is absolute because the daemon's PATH does not include ~/.local/bin.
On any hook failure Voxtype types the original text, so dictation never breaks.
EOF
    ;;

  app)
    if [[ $(uname -s) != Darwin ]]; then
      print -u2 "voxhist app: macOS only"
      exit 1
    fi
    if ! (( $+commands[swiftc] )); then
      print -u2 "voxhist: swiftc not found — install the Xcode Command Line Tools: xcode-select --install"
      exit 1
    fi
    local src=${0:A:h}/lib/voxhist/app/main.swift
    local app=$HOME/Applications/VoxHistBar.app
    local bin=$app/Contents/MacOS/VoxHistBar
    mkdir -p ${bin:h}
    print -u2 "\$ swiftc -O -swift-version 5 ${src:t} -o $bin"
    swiftc -O -swift-version 5 "$src" -o "$bin" || exit 1
    cat > $app/Contents/Info.plist <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>         <string>com.athosmartinez.terminal-tools.voxhistbar</string>
  <key>CFBundleName</key>               <string>VoxHistBar</string>
  <key>CFBundleExecutable</key>         <string>VoxHistBar</string>
  <key>CFBundlePackageType</key>        <string>APPL</string>
  <key>CFBundleShortVersionString</key> <string>1.0</string>
  <key>CFBundleVersion</key>            <string>1</string>
  <key>LSMinimumSystemVersion</key>     <string>13.0</string>
  <key>LSUIElement</key>                <true/>
</dict>
</plist>
EOF
    # Ad-hoc signature: required on Apple Silicon and by SMAppService.
    print -u2 "\$ codesign --force --sign - $app"
    codesign --force --sign - "$app" || exit 1
    pkill -x VoxHistBar && sleep 0.5
    print -u2 "\$ open $app"
    open "$app"
    ;;

  *) usage >&2; exit 1 ;;
esac
