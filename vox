#!/usr/bin/env zsh
#
# vox — Voxtype companion: the daemon state and the last transcriptions, so a
# lost one can be copied again. Voxtype itself keeps no history: its log
# restarts with the daemon.
#
# `vox record` is the Voxtype post-process hook: it gets each transcription on
# stdin, prints it back unchanged (Voxtype types what the hook prints) and
# saves it. `vox app` builds VoxBar, the menu bar item: daemon state, restart,
# log, and the history with copy on click (macOS). Both read the same file.
#
emulate -L zsh
zmodload zsh/datetime

HIST=${VOX_HISTORY_FILE:-${XDG_DATA_HOME:-$HOME/.local/share}/terminal-tools/vox-history}
MAX=${VOX_HISTORY_MAX:-15}
RS=$'\036'   # record separator: a dictation can hold newlines and tabs, never this
# The daemon writes these (`state_file = "auto"` in its config).
STATE_DIR=${VOX_STATE_DIR:-/tmp/voxtype}

usage() {
  cat <<'EOF'
vox — Voxtype state and the last transcriptions, to copy one again

  vox                 list the transcriptions, newest first (default)
  vox copy [n]        copy entry n to the clipboard (1 = newest, the default)
  vox clear           delete the history
  vox status          show the daemon state: ready, recording, transcribing, not running
  vox hook            print the Voxtype config that saves each transcription
  vox app             build and open VoxBar, the menu bar item (macOS)
  vox record          the hook itself: stdin -> stdout unchanged, then saved

Keeps the last 15 (VOX_HISTORY_MAX) in ~/.local/share/terminal-tools/vox-history,
readable only by you. Everything you dictate lands there in plain text.
EOF
}

# The file is records "<epoch>\t<text>" joined by RS, oldest first.
typeset -ga ENTRIES
load() {
  ENTRIES=()
  [[ -r $HIST ]] && ENTRIES=( "${(@ps:$RS:)$(<$HIST)}" )
  ENTRIES=( "${(@)ENTRIES:#}" )
}

record() {
  local text
  text=$(cat; print -n x); text=${text%x}   # $(...) would drop trailing newlines
  print -rn -- "$text"
  [[ -n ${text//[[:space:]]/} ]] || return 0
  umask 077
  mkdir -p ${HIST:h}
  load
  ENTRIES+=( "$EPOCHSECONDS"$'\t'"$text" )
  (( ${#ENTRIES} > MAX )) && ENTRIES=( "${(@)ENTRIES[-MAX,-1]}" )
  # Write then rename, so the menu bar app never reads half a file.
  print -rn -- "${(pj:$RS:)ENTRIES}" > $HIST.tmp && mv -f $HIST.tmp $HIST
}

case ${1:-list} in
  -h|--help) usage ;;

  record) record ;;

  list)
    load
    if (( ! ${#ENTRIES} )); then
      print -u2 "vox: no transcriptions yet — see 'vox hook'"
      exit 0
    fi
    local i entry
    for (( i = ${#ENTRIES}; i >= 1; i-- )); do
      entry=${ENTRIES[i]}
      printf '\033[36m%2d\033[0m \033[38;5;243m%s\033[0m  %s\n' $(( ${#ENTRIES} - i + 1 )) \
        "$(strftime '%d/%m %H:%M' ${entry%%$'\t'*})" "${${entry#*$'\t'}//$'\n'/ ⏎ }"
    done
    ;;

  copy)
    load
    local n=${2:-1}
    if [[ $n != <1-> ]] || (( n > ${#ENTRIES} )); then
      print -u2 "vox: no entry $n (${#ENTRIES} saved)"
      exit 1
    fi
    source ${0:A:h}/lib/kubetui.zsh   # clip: the one cross-platform clipboard helper
    local entry=${ENTRIES[$(( ${#ENTRIES} - n + 1 ))]}
    clip "${entry#*$'\t'}"
    ;;

  clear)
    rm -f $HIST && print "vox: history cleared"
    ;;

  status)
    # A dead pid means the daemon crashed or was stopped; its state file stays.
    local pid=$(<$STATE_DIR/pid 2>/dev/null)
    if [[ $pid != <1-> ]] || ! kill -0 $pid 2>/dev/null; then
      print "not running"
      exit 1
    fi
    local state=$(<$STATE_DIR/state 2>/dev/null)
    case $state in
      recording|transcribing) print $state ;;
      *) print ready ;;
    esac
    ;;

  hook)
    cat <<EOF
Add this to ~/Library/Application Support/voxtype/config.toml (macOS) or
~/.config/voxtype/config.toml (Linux), then restart the daemon:

[output.post_process]
command = "${0:A} record"
timeout_ms = 2000

macOS restart: launchctl kickstart -k gui/\$(id -u)/io.voxtype.daemon
The path is absolute because the daemon's PATH does not include ~/.local/bin.
On any hook failure Voxtype types the original text, so dictation never breaks.
EOF
    ;;

  app)
    if [[ $(uname -s) != Darwin ]]; then
      print -u2 "vox app: macOS only"
      exit 1
    fi
    if ! (( $+commands[swiftc] )); then
      print -u2 "vox: swiftc not found — install the Xcode Command Line Tools: xcode-select --install"
      exit 1
    fi
    local src=${0:A:h}/lib/vox/app/main.swift
    local app=$HOME/Applications/VoxBar.app
    local bin=$app/Contents/MacOS/VoxBar
    mkdir -p ${bin:h}
    print -u2 "\$ swiftc -O -swift-version 5 ${src:t} -o $bin"
    swiftc -O -swift-version 5 "$src" -o "$bin" || exit 1
    # iconutil needs every size in an .iconset folder; sips makes them from one PNG.
    local png=${src:h}/AppIcon.png icns=$app/Contents/Resources/AppIcon.icns
    local iconset=$(mktemp -d)/AppIcon.iconset size
    mkdir -p $iconset ${icns:h}
    for size in 16 32 128 256 512; do
      sips -z $size $size "$png" --out $iconset/icon_${size}x${size}.png >/dev/null
      sips -z $((size * 2)) $((size * 2)) "$png" --out $iconset/icon_${size}x${size}@2x.png >/dev/null
    done
    print -u2 "\$ iconutil -c icns ${iconset:t} -o $icns"
    iconutil -c icns $iconset -o "$icns"
    local icon_rc=$?
    rm -rf ${iconset:h}
    (( icon_rc == 0 )) || exit 1
    cat > $app/Contents/Info.plist <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>         <string>com.athosmartinez.terminal-tools.voxbar</string>
  <key>CFBundleName</key>               <string>VoxBar</string>
  <key>CFBundleExecutable</key>         <string>VoxBar</string>
  <key>CFBundleIconFile</key>           <string>AppIcon</string>
  <key>CFBundlePackageType</key>        <string>APPL</string>
  <key>CFBundleShortVersionString</key> <string>1.0</string>
  <key>CFBundleVersion</key>            <string>1</string>
  <key>LSMinimumSystemVersion</key>     <string>13.0</string>
  <key>LSUIElement</key>                <true/>
</dict>
</plist>
EOF
    # Ad-hoc signature: required on Apple Silicon and by SMAppService.
    print -u2 "\$ codesign --force --sign - $app"
    codesign --force --sign - "$app" || exit 1
    pkill -x VoxBar && sleep 0.5
    print -u2 "\$ open $app"
    open "$app"
    ;;

  *) usage >&2; exit 1 ;;
esac
