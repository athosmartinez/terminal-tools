#!/usr/bin/env zsh
#
# monitor — turn the external display off/on without unplugging it (macOS).
# The USB-C cable stays connected, so a Power Delivery monitor keeps charging.
#
# The work is done by lib/monitor/ (Swift; it needs a private CoreGraphics
# call). This wrapper compiles the CLI on first run and whenever a source is
# newer than the cached binary, so editing the repo stays live like the other
# tools. `monitor app` builds the menu bar app from the same core.
#
emulate -L zsh

usage() {
  cat <<'EOF'
monitor — turn the external display off/on without unplugging it (macOS)

  monitor off       stop sending video to the external display (charging continues)
  monitor on        bring it back
  monitor hdmi      switch the monitor to its HDMI input over DDC, then turn off
  monitor input <n> send a raw DDC input value (to find your monitor's numbers)
  monitor status    show whether it is on (default)
  monitor app       build and open MonitorBar, a menu bar toggle
                    (~/Applications/MonitorBar.app; no Dock icon, starts at login)

The HDMI value is vendor-specific: set it in ~/.config/terminal-tools/monitor.conf
as hdmi_input=<n> (default 17, the MCCS value; Samsung monitors use 5).

Refuses 'off' while the built-in display is inactive (lid closed), so the Mac
is never left without a screen. Unplugging and replugging the cable also
restores the display.
EOF
}

case $1 in
  -h|--help) usage; exit 0 ;;
esac

if [[ $(uname -s) != Darwin ]]; then
  print -u2 "monitor: macOS only"
  exit 1
fi

if ! (( $+commands[swiftc] )); then
  need_swiftc() { print -u2 "monitor: swiftc not found — install the Xcode Command Line Tools: xcode-select --install"; exit 1 }
else
  need_swiftc() { : }
fi

SRC=${0:A:h}/lib/monitor
CORE=( $SRC/*.swift )   # shared by the CLI and the app
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/terminal-tools

# Swift 5 language mode: the app's C display callback and AppKit delegate
# don't need Swift 6 strict-concurrency annotations for a single-threaded tool.
build() {  # build <output> <sources...>
  local out=$1; shift
  need_swiftc
  mkdir -p ${out:h}
  print -u2 "\$ swiftc -O -swift-version 5 ${@:t} -o $out"
  swiftc -O -swift-version 5 "$@" -o "$out"
}

if [[ $1 == app ]]; then
  APP=$HOME/Applications/MonitorBar.app
  BIN=$APP/Contents/MacOS/MonitorBar
  build "$BIN" $CORE "$SRC/app/main.swift" || exit 1
  cat > $APP/Contents/Info.plist <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>         <string>com.athosmartinez.terminal-tools.monitorbar</string>
  <key>CFBundleName</key>               <string>MonitorBar</string>
  <key>CFBundleExecutable</key>         <string>MonitorBar</string>
  <key>CFBundlePackageType</key>        <string>APPL</string>
  <key>CFBundleShortVersionString</key> <string>1.0</string>
  <key>CFBundleVersion</key>            <string>1</string>
  <key>LSMinimumSystemVersion</key>     <string>13.0</string>
  <key>LSUIElement</key>                <true/>
</dict>
</plist>
EOF
  # Ad-hoc signature: required to run on Apple Silicon and for SMAppService
  # (Launch at Login) to accept the bundle.
  print -u2 "\$ codesign --force --sign - $APP"
  codesign --force --sign - "$APP" || exit 1
  # Replace a running copy so the new build takes effect.
  pkill -x MonitorBar && sleep 0.5
  print -u2 "\$ open $APP"
  open "$APP"
  exit
fi

BIN=$CACHE/monitor
stale=0
[[ -x $BIN ]] || stale=1
for f in $CORE $SRC/cli/main.swift; do [[ $f -nt $BIN ]] && stale=1; done
if (( stale )); then
  build "$BIN" $CORE "$SRC/cli/main.swift" || exit 1
fi

exec "$BIN" "$@"
