#!/usr/bin/env bash
set -euo pipefail

INTERNAL='^(eDP|LVDS|DSI)'
JQ_DEFS='def kind:
  if (.name | test($re)) then "internal"
  elif .make == "" and .model == "" then "virtual"
  else "external" end;
def display_state:
  [.[] | select(kind == "external")] as $ext
  | if ($ext | length) == 0 then "absent"
    elif any($ext[]; .disabled == false and .dpmsStatus == true) then "on"
    elif any(.[]; kind == "virtual" and .disabled == false) then "streaming"
    else "off" end;'
PLUGIN_ID=terminal-tools.monitor
PLUGIN_SRC=$(dirname "$(readlink -f "$0")")/lib/monitor/omarchy
PLUGIN_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/$PLUGIN_ID
LID_DIR=${MONITOR_LID_DIR:-/proc/acpi/button/lid}
PAUSE_MARK=${XDG_RUNTIME_DIR:-/tmp}/terminal-tools-monitor.pause

usage() {
  cat <<'EOF'
monitor — turn the external display off/on (Linux, Hyprland)

  monitor off         remove the external display from the layout
  monitor on          bring it back (hyprctl reload re-applies your monitor rules)
  monitor pause [s]   turn the external display off for s seconds (default 15), then back on
  monitor status      print on, off, streaming or absent (default)
  monitor outputs     print every output as JSON: kind, state, mode and why it is off
  monitor auto        turn a disabled external display back on when the lid is closed
  monitor bar         install the Omarchy bar widget

A virtual output (headless, no make or model, e.g. a game-streaming display)
is never treated as an external display. 'streaming' means the external
display is off while a virtual output is on; 'auto' leaves that state alone.
'off' refuses when the lid is closed or no built-in display stays active.
'pause' also works with the lid closed, leaving no screen until it ends;
'auto' leaves a running pause alone.
EOF
}

fail() {
  echo "monitor: $*" >&2
  exit 1
}

run() {
  echo "\$ $*" >&2
  "$@"
}

monitors() { hyprctl monitors all -j; }

query() {
  local json=$1 filter=$2
  shift 2
  jq "$@" --arg re "$INTERNAL" "$JQ_DEFS $filter" <<<"$json"
}

names() { query "$1" ".[] | select($2) | .name" -r; }

external() { echo "kind == \"external\" and ($1)"; }

lid_closed() { grep -qs closed "$LID_DIR"/*/state; }

pausing() { [[ -s $PAUSE_MARK ]] && kill -0 "$(<"$PAUSE_MARK")" 2>/dev/null; }

dpms() {
  run hyprctl dispatch "hl.dsp.dpms({ action = \"$1\", monitor = \"$2\" })"
}

state() { query "$1" 'display_state' -r; }

outputs() {
  local lid=false
  lid_closed && lid=true
  query "$(monitors)" '
    def title:
      if kind == "internal" then "Built-in"
      elif kind == "virtual" then .name
      else [(.make // "" | split(" ")[0] // ""), (.model // "")] | map(select(. != "")) | join(" ") end;
    (display_state == "streaming") as $streaming
    | map({
        name,
        kind: kind,
        label: (title | if . == "" then null else . end) // .name,
        state: (if .disabled then "off" elif .dpmsStatus then "on" else "asleep" end),
        mode: (if .disabled then "" else "\(.width)x\(.height)" end),
        reason: (
          if .disabled | not then ""
          elif kind == "internal" and $lid then "lid closed"
          elif kind == "external" and $streaming then "streaming"
          else "" end)
      })' -c --argjson lid "$lid"
}

turn_off() {
  local json active builtin
  json=$(monitors)
  mapfile -t active < <(names "$json" "$(external '.disabled == false')")
  ((${#active[@]})) || fail "no active external display"
  mapfile -t builtin < <(names "$json" 'kind == "internal" and .disabled == false')
  if ((${#builtin[@]} == 0)) || lid_closed; then
    fail "lid is closed or the built-in display is inactive — refusing to leave no screen"
  fi
  disable "${active[@]}"
}

disable() {
  for name; do
    run hyprctl eval "hl.monitor({ output = \"$name\", disabled = true })"
  done
}

turn_on() {
  local json disabled asleep
  json=$(monitors)
  mapfile -t disabled < <(names "$json" "$(external '.disabled == true')")
  mapfile -t asleep < <(names "$json" "$(external '.disabled == false and .dpmsStatus == false')")
  ((${#disabled[@]} + ${#asleep[@]})) || fail "no external display is off"
  if ((${#disabled[@]})); then
    run hyprctl reload
  fi
  for name in "${asleep[@]}"; do
    dpms enable "$name"
  done
}

pause() {
  local seconds=${1:-15} active
  [[ $seconds =~ ^[0-9]+$ ]] || fail "pause: seconds must be a whole number"
  mapfile -t active < <(names "$(monitors)" "$(external '.disabled == false')")
  ((${#active[@]})) || fail "no active external display"
  echo $$ >"$PAUSE_MARK"
  trap 'rm -f "$PAUSE_MARK"' EXIT
  disable "${active[@]}"
  sleep "$seconds"
  run hyprctl reload
}

auto_on() {
  local json disabled
  if pausing || ! lid_closed; then
    return 0
  fi
  json=$(monitors)
  [[ $(state "$json") == streaming ]] && return 0
  mapfile -t disabled < <(names "$json" "$(external '.disabled == true')")
  if ((${#disabled[@]})); then
    run hyprctl reload
  fi
}

install_bar() {
  run mkdir -p "$PLUGIN_DIR"
  run cp "$PLUGIN_SRC"/* "$PLUGIN_DIR"/
  run omarchy plugin validate "$PLUGIN_DIR"
  run omarchy-shell shell rescanPlugins
  run omarchy plugin enable "$PLUGIN_ID" --section right
}

case ${1:-status} in
  status) state "$(monitors)" ;;
  outputs) outputs ;;
  off) turn_off ;;
  on) turn_on ;;
  pause) pause "${2:-}" ;;
  auto) auto_on ;;
  bar) install_bar ;;
  -h | --help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
