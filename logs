#!/usr/bin/env zsh
#
# logs — follow Kubernetes workload logs interactively (fzf + kubectl)
#
#   logs                 interactive picker: deployments/statefulsets/daemonsets
#   logs <query>         1 match → follow immediately; several → pre-filtered picker
#   logs -n <N> [query]  initial history lines (default 100)
#   logs -p [query]      logs of a pod's PREVIOUS container (CrashLoop), no follow
#   logs -h | --help     help
#
# Picker: Enter follow · Ctrl-P pod view · Esc quit
# Following: reconnects on its own when the stream dies; Ctrl-C quits.
#
# Depends on: kubectl, fzf (brew). Shared code: lib/kubetui.zsh.

emulate -L zsh
setopt no_nomatch

SELF=${0:A}
source ${0:A:h}/lib/kubetui.zsh

need kubectl "install kubectl first"
need fzf "brew install fzf"

usage() {
  cat <<'EOF'
logs — follow Kubernetes workload logs interactively

USAGE
  logs                 interactive picker (arrows, type to filter)
  logs <query>         1 match → follow immediately; several → pre-filtered picker
  logs -n <N> [query]  initial history lines (default 100)
  logs -p [query]      logs of a pod's PREVIOUS container (CrashLoop), no follow
  logs -h | --help     this help

PICKER
  ↑/↓ move · type to filter · Enter follow · Ctrl-P pod view · ? keys · Esc quit
  The list auto-refreshes every LOGS_REFRESH seconds (default 5; 0 disables).

FOLLOWING
  All pods of the workload, each line prefixed with the pod name (one color per pod).
  If the stream dies (deploy, restart), it reconnects on its own. Ctrl-C quits.
  Always uses the current kubectl context.
EOF
}

# ── keybindings help (shown by pressing ? in the picker) ─────────────────────
keys() {
  { print -P "%B%F{cyan}logs — keys%f%b"
    print
    print    "  ↑ / ↓        move                 type       filter"
    print    "  Enter        follow logs          Ctrl-P     pod view"
    print    "  Ctrl-N       namespace filter     Ctrl-T     cycle sort (name/ns/unready)"
    print    "  ?            this help            Esc        quit"
    print
    print -P "%F{cyan}The workload list auto-refreshes every ${LOGS_REFRESH:-5}s (set LOGS_REFRESH; 0 disables).%f"
    print -P "%F{cyan}Following: all pods of the workload, one color per pod; auto-reconnect.%f"
    print -P "%F{cyan}Ctrl-C stops following. Every follow prints the real \$ kubectl logs -f command.%f"
    print
    print    "(press q to return to the picker)"
  } | page
}

# ── picker state (namespace filter + sort) ───────────────────────────────────
# Header for the workload picker: keybar + ns/sort status (line 1), column
# labels (line 2). Reads $LOGS_STATE. Paren-free (fzf change-header argument).
logs_header() {
  local C=$'\033[36m' D=$'\033[38;5;243m' B=$'\033[1m' R=$'\033[0m' ns sort
  ns=$(cat $LOGS_STATE/ns 2>/dev/null); sort=$(cat $LOGS_STATE/sort 2>/dev/null)
  local bar="${C}Enter$R$D follow$R  ${C}^P$R$D pods$R  ${C}^N$R$D ns$R  ${C}^T$R$D sort$R  ${D}? help$R  ${D}Esc$R"
  bar+="   ${D}ns:$R ${ns:-all}   ${D}sort:$R ${sort:-name}"
  printf '%s\n%s' "$bar" "$(printf "$B%-20s  %-36s  %-7s  %-7s$R" NAMESPACE WORKLOAD KIND READY)"
}

# Workload rows honoring the namespace filter + sort in $LOGS_STATE.
fzf_src() {
  local nsf srt rows
  nsf=$(cat $LOGS_STATE/ns 2>/dev/null); srt=$(cat $LOGS_STATE/sort 2>/dev/null)
  rows=$(collect_workloads)
  [[ -n $nsf ]] && rows=$(print -r -- "$rows" | awk -F'\t' -v n="$nsf" '$1==n')
  case $srt in
    ns)      rows=$(print -r -- "$rows" | sort -t$'\t' -k1,1 -k2,2) ;;
    unready) rows=$(print -r -- "$rows" | awk -F'\t' '{split($4,r,"/"); print (r[1]+0<r[2]+0?0:1)"\t"$0}' | sort -k1,1 | cut -f2-) ;;
    *)       rows=$(print -r -- "$rows" | sort -t$'\t' -k2,2) ;;
  esac
  print -r -- "$rows" | to_fzf_lines
}

# Namespace picker → writes $LOGS_STATE/ns (empty = all). Runs under fzf execute.
pick_ns() {
  local pick
  pick=$( { print all; kubectl get ns --no-headers -o custom-columns=N:.metadata.name 2>/dev/null } \
    | fzf --prompt='namespace> ' --layout=reverse --height=40% ) || return
  [[ -z $pick ]] && return
  [[ $pick == all ]] && : > $LOGS_STATE/ns || print -r -- $pick > $LOGS_STATE/ns
}

# Cycle sort name→ns→unready; print the fzf actions to refresh header + list.
cycle_sort() {
  local s=$(cat $LOGS_STATE/sort 2>/dev/null)
  case $s in name) s=ns;; ns) s=unready;; *) s=name;; esac
  print -r -- $s > $LOGS_STATE/sort
  printf 'change-header(%s)+reload(%s --fzf-src)' "$(logs_header)" "$SELF"
}

sync_hdr() { printf 'change-header(%s)+reload(%s --fzf-src)' "$(logs_header)" "$SELF" }

direct() {
  local q=$1 all rows
  all=$(collect_workloads)
  [[ -z $all ]] && die "no workloads found — is the cluster reachable? (context: $(kubectl config current-context 2>/dev/null))"
  rows=$(print -r -- $all | awk -F'\t' -v q="${q:l}" \
    'index(tolower($1), q) || index(tolower($2), q)')
  [[ -z $rows ]] && die "no workload matches \"$q\""
  if (( $(print -r -- $rows | grep -c '') == 1 )); then
    local ns name kind ready
    IFS=$'\t' read -r ns name kind ready <<< $rows
    follow_workload $ns $kind $name $TAIL
  else
    interactive $q
  fi
}

interactive() {
  local query=$1
  # Picker state (namespace filter + sort), read by --fzf-src and the header;
  # exported so the fzf-spawned child dispatches (--pick-ns, --sync, …) see it.
  LOGS_STATE=$(mktemp -d) || die "mktemp failed"
  export LOGS_STATE
  : > $LOGS_STATE/ns
  print -r -- name > $LOGS_STATE/sort
  trap 'rm -rf $LOGS_STATE' EXIT

  local input; input=$($SELF --fzf-src)
  [[ -z $input ]] && die "no workloads found — is the cluster reachable? (context: $(kubectl config current-context 2>/dev/null))"

  # Auto-refresh: ON by default; LOGS_REFRESH seconds (0 disables). fzf reloads
  # the workload list in place (load→reload loop), keeping the query and cursor.
  local -i refresh=${LOGS_REFRESH:-5}
  local -a rbind
  (( refresh > 0 )) && rbind=(--bind="load:reload:sleep $refresh; $SELF --fzf-src")

  local out key sel
  out=$(print -r -- "$input" | fzf --ansi --delimiter="$DELIM" --with-nth=1 \
    --query="$query" --expect=ctrl-p \
    --prompt='logs> ' --layout=reverse --info=inline --pointer='▸' \
    --header="$(logs_header)" \
    --bind="?:execute($SELF --keys)" \
    --bind="ctrl-n:execute($SELF --pick-ns)+transform($SELF --sync)" \
    --bind="ctrl-t:transform($SELF --cycle-sort)" \
    "${rbind[@]}" \
    --preview="$SELF --preview {2} {3} {4}" \
    --preview-window='right,45%,wrap') || return 0

  key=$(head -1 <<< $out)
  sel=$(sed -n 2p <<< $out)

  local _ ns kind name
  [[ -n $sel ]] && IFS=$DELIM read -r _ ns kind name <<< $sel

  if [[ $key == ctrl-p ]]; then
    pods_picker "${ns:+$ns }" follow
    return
  fi
  [[ -z $sel ]] && return 0
  follow_workload $ns $kind $name $TAIL
}

# ── dispatch ─────────────────────────────────────────────────────────────────
PREV=0
POS=()
while (( $# )); do
  case $1 in
    --preview)      shift; do_preview "$@"; exit 0 ;;
    --preview-pod)  shift; do_preview_pod "$@"; exit 0 ;;
    --keys)         keys; exit 0 ;;
    --fzf-src)      fzf_src; exit 0 ;;
    --pick-ns)      pick_ns; exit 0 ;;
    --cycle-sort)   cycle_sort; exit 0 ;;
    --sync)         sync_hdr; exit 0 ;;
    --list)         collect_workloads; exit 0 ;;
    -n)             shift; [[ ${1:-} == <-> ]] || die "-n requires a number"; TAIL=$1 ;;
    -p)             PREV=1 ;;
    -h|--help)      usage; exit 0 ;;
    -*)             die "unknown flag: $1 (see logs -h)" ;;
    *)              POS+=("$1") ;;
  esac
  shift
done

q=${POS[1]:-}
if (( PREV )); then
  pods_picker "$q" previous
elif [[ -z $q ]]; then
  interactive ""
else
  direct "$q"
fi
